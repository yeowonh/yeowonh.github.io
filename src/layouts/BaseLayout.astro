---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';

import Sidebar from '../components/Sidebar.astro';
import Navbar from '../components/Navbar.astro';
import { site } from '../data/site';

interface Props {
  /** Browser tab / OG title. Omit on the landing page. */
  title?: string;
  /** Big heading rendered at the top of the content card. */
  heading: string;
  description?: string;
}

const { title, heading, description } = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} | ${site.title}`;
const pageDesc = description ?? site.intro[0];
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="theme-color" content="#eef0f5" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <div class="shell">
      <Sidebar />

      <main class="main card">
        <Navbar />

        <div class="body">
          <h2 class="page-title">{heading}</h2>

          <slot />

          <footer class="foot">
            <span>© {year} {site.name}</span>
            <span>
              <a href={site.links.github} target="_blank" rel="noopener">GitHub</a>
              &nbsp;·&nbsp;
              <a href={site.links.blog} target="_blank" rel="noopener">Blog</a>
            </span>
          </footer>
        </div>
      </main>
    </div>
  </body>
</html>

---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('projects', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, category, period, role, stack, links } = entry.data;
---

<BaseLayout
  title={title}
  heading={title}
  description={summary}
  image={entry.data.cover?.src}
>
  <section class="project-overview" aria-labelledby="project-overview-title">
    <h2 class="project-kicker" id="project-overview-title">Project Overview</h2>
    <p class="project-summary">{summary}</p>
    {
      entry.data.cover && (
        <Image
          class="project-overview-cover"
          src={entry.data.cover}
          alt={entry.data.coverAlt ?? `${title} project thumbnail`}
          width={960}
          height={720}
        />
      )
    }
  </section>

  <dl class="detail-meta">
    <div>
      <dt>Category</dt>
      <dd>{category}</dd>
    </div>
    <div>
      <dt>Period</dt>
      <dd>{period}</dd>
    </div>
    {
      role && (
        <div class="meta-wide">
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
      )
    }
    {
      stack.length > 0 && (
        <div class="meta-wide">
          <dt>Stack</dt>
          <dd>
            <ul class="stack-tags" aria-label="Technology stack">
              {stack.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
      )
    }
    {
      links.length > 0 && (
        <div class="meta-wide">
          <dt>Links</dt>
          <dd>
            {links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener">
                {l.label}
              </a>
            ))}
          </dd>
        </div>
      )
    }
  </dl>

  <div class="content">
    <Content />
  </div>

  <p style="margin-top:34px">
    <a class="back" href="/projects"><Icon name="arrowLeft" size={15} /> All projects</a>
  </p>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteKo as site } from '../../data/site';
import { publications, awards } from '../../data/resume.ko';

const featured = (await getCollection('projectsKo', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => b.data.order - a.data.order,
);

const featuredGroups = Array.from(new Set(featured.map((entry) => entry.data.category))).map((category) => ({
  category,
  entries: featured.filter((entry) => entry.data.category === category),
}));
---

<BaseLayout heading="소개" locale="ko">
  <div class="prose">
    {site.intro.map((para) => <p>{para}</p>)}
  </div>

  <section class="section">
    <h3 class="section-title">주요 업무</h3>
    <ul class="services">
      {
        site.services.map((s) => (
          <li class="service">
            <div class="service-ico"><Icon name={s.icon} /></div>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h3 class="section-title">주요 프로젝트</h3>
    <div class="work-groups">
      {
        featuredGroups.map((group) => (
          <section class="work-group">
            <h4 class="work-group-title">{group.category}</h4>
            <div class="work-list">
              {
                group.entries.map((entry) => (
                  <a class="work-row" href={`/ko/projects/${entry.id}`}>
                    <div class="work-row-thumb">
                      {entry.data.cover ? (
                        <Image src={entry.data.cover} alt={entry.data.coverAlt ?? entry.data.title} width={192} height={144} fit="contain" />
                      ) : (
                        <div class:list={['work-row-thumb-fallback', entry.data.tint]}>
                          <span>{entry.data.mark || entry.data.title.slice(0, 2)}</span>
                        </div>
                      )}
                    </div>
                    <div class="work-row-main">
                      <div class="work-row-head">
                        <h5>{entry.data.title}</h5>
                        <span class="yr">{entry.data.period}</span>
                      </div>
                      {entry.data.organization && <span class="org">{entry.data.organization}</span>}
                      <span class="cat">{entry.data.category}</span>
                      <p>{entry.data.summary}</p>
                    </div>
                  </a>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
    <a class="more-link" href="/ko/projects">전체 프로젝트 →</a>
  </section>

  {publications.length > 0 && (
    <section class="section">
      <h3 class="section-title">논문·연구 성과</h3>
      <ul class="recog-grid">
        {publications.map((publication) => (
          <li class="recog">
            <div class="recog-ico"><Icon name="file" /></div>
            <div>
              <h4>
                {publication.href ? (
                  <a href={publication.href} target="_blank" rel="noopener">{publication.title}</a>
                ) : publication.title}
              </h4>
              <span class="src">{publication.venue} · {publication.date}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {awards.length > 0 && (
    <section class="section">
      <h3 class="section-title">대회·수상</h3>
      <ul class="recog-grid">
        {awards.map((award) => (
          <li class="recog">
            <div class="recog-ico"><Icon name="award" /></div>
            <div>
              <h4>{award.title}</h4>
              <span class="src">{award.org} · {award.date}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

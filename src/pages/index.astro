---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { publications, awards } from '../data/resume';

const featured = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => b.data.order - a.data.order,
);

const featuredGroups = Array.from(new Set(featured.map((entry) => entry.data.category))).map((category) => ({
  category,
  entries: featured.filter((entry) => entry.data.category === category),
}));
---

<BaseLayout heading="About Me">
  <div class="prose">
    {site.intro.map((para) => <p>{para}</p>)}
  </div>

  <section class="section">
    <h3 class="section-title">What I'm Doing</h3>
    <ul class="services">
      {
        site.services.map((s) => (
          <li class="service">
            <div class="service-ico"><Icon name={s.icon} /></div>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section selected-work-section">
    <h3 class="section-title">Selected Work</h3>
    <div class="featured-projects">
      {
        featuredGroups.map((group) => (
          <section class="featured-project-group">
            <h4 class="featured-project-group-title">{group.category}</h4>
            <div class="featured-project-list">
              {
                group.entries.map((entry) => (
                  <a class="featured-project-row" href={`/projects/${entry.id}`}>
                    <div class="featured-project-thumb">
                      {entry.data.cover ? (
                <Image src={entry.data.cover} alt={entry.data.coverAlt ?? entry.data.title} width={192} height={144} fit="contain" />
                      ) : (
                        <div class:list={['featured-project-thumb-fallback', entry.data.tint]}>
                          <span>{entry.data.mark || entry.data.title.slice(0, 2)}</span>
                        </div>
                      )}
                    </div>
                    <div class="featured-project-main">
                      <div class="featured-project-head">
                        <h5>{entry.data.title}</h5>
                        <span class="yr">{entry.data.period}</span>
                      </div>
                      <div class="featured-project-meta">
                        {entry.data.organization && <span class="org">{entry.data.organization}</span>}
                        <span class="cat">{entry.data.category}</span>
                      </div>
                      <p>{entry.data.summary}</p>
                    </div>
                  </a>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
    <a class="more-link" href="/projects">All projects →</a>
  </section>

  {publications.length > 0 && (
    <section class="section">
      <h3 class="section-title">Publications</h3>
      <ul class="recog-grid">
        {publications.map((publication) => (
          <li class="recog">
            <div class="recog-ico"><Icon name="file" /></div>
            <div>
              <h4>
                {publication.href ? (
                  <a href={publication.href} target="_blank" rel="noopener">{publication.title}</a>
                ) : publication.title}
              </h4>
              <span class="src">{publication.venue} · {publication.date}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {awards.length > 0 && (
    <section class="section">
      <h3 class="section-title">Awards &amp; Competitions</h3>
      <ul class="recog-grid">
        {awards.map((award) => (
          <li class="recog">
            <div class="recog-ico"><Icon name="award" /></div>
            <div>
              <h4>{award.title}</h4>
              <span class="src">{award.org} · {award.date}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

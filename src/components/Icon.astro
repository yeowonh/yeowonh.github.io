};

const isBrand = name in brands;
const markup = isBrand ? `<path d="${brands[name]}"/>` : (outlines[name] ?? '');
---

<svg
  viewBox="0 0 24 24"
  fill={isBrand ? 'currentColor' : 'none'}
  stroke={isBrand ? undefined : 'currentColor'}
  stroke-width={isBrand ? undefined : 1.8}
  stroke-linecap={isBrand ? undefined : 'round'}
  stroke-linejoin={isBrand ? undefined : 'round'}
  aria-hidden="true"
  width={size}
  height={size}
  set:html={markup}
></svg>

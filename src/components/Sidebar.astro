---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getSite, type Locale } from '../data/site';
import profile from '../assets/profile.jpeg';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const site = getSite(locale);
const labels = { email: 'Email', location: 'Location', status: 'Status', portrait: `Portrait of ${site.name}` };

const socials = [
  { label: 'GitHub', href: site.links.github, icon: 'github' },
  { label: 'Blog', href: site.links.blog, icon: 'globe' },
  { label: 'LinkedIn', href: site.links.linkedin, icon: 'linkedin' },
].filter((s) => s.href);
---

<aside class="sidebar card">
  <Image class="avatar" src={profile} alt={labels.portrait} width={480} height={600} loading="eager" />

  <div class="who">
    <h1>{site.name}</h1>
    <p><span class="badge">{site.title}</span></p>
    {site.company && <p class="org">{site.company}</p>}
  </div>

  <hr />

  <ul class="facts">
    <li class="fact">
      <div class="fact-ico"><Icon name="mail" /></div>
      <div>
        <span class="fact-label">{labels.email}</span>
        <a class="fact-value" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </li>

    <li class="fact">
      <div class="fact-ico"><Icon name="pin" /></div>
      <div>
        <span class="fact-label">{labels.location}</span>
        <span class="fact-value">{site.location}</span>
      </div>
    </li>

    <li class="fact">
      <div class="fact-ico"><Icon name="github" /></div>
      <div>
        <span class="fact-label">GitHub</span>
        <a class="fact-value" href={site.links.github} target="_blank" rel="noopener">
          github.com/yeowonh
        </a>
      </div>
    </li>

    {
      site.availability && (
        <li class="fact">
          <div class="fact-ico"><Icon name="check" /></div>
          <div>
            <span class="fact-label">{labels.status}</span>
            <span class="fact-value">{site.availability}</span>
          </div>
        </li>
      )
    }
  </ul>

  <ul class="socials">
    {
      socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
            <Icon name={s.icon} />
          </a>
        </li>
      ))
    }
  </ul>
</aside>
